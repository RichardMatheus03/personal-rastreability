# Referência somente leitura: nomes e endereços lidos do sigti-backend.
# Este repositório não altera aquele projeto.

# Fuso do processo e da janela 23h–06h.
TZ=America/Bahia

# Nome da rede Docker já criada pelo sigti. O valor é {COMPOSE_PROJECT_NAME}_default.
# Local (COMPOSE_PROJECT_NAME=touros-educacao-backend): touros-educacao-backend_default
# VPS (COMPOSE_PROJECT_NAME=touros-transporte-backend): touros-transporte-backend_default
SIGTI_DOCKER_NETWORK=

# Endereço que o listener usa para gravar. No sigti o cache é o database 1.
REDIS_URL=redis://redis:6379/1

# WhatsappEvolutionClient.BASE_URL vem de EVOLUTION_SERVER_URL.
EVOLUTION_SERVER_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_PERSONAL_INSTANCE_NAME=

# Número que recebe as mensagens de process_come_home e alert_movement.
EMERGENCY_CONTACT=

MAXGO_WEB_URL=
MAXGO_API_URL=
MAXGO_STOMP_URL=wss://srvskr.logicasolucoes.com.br/stomp
MAXGO_USERNAME=
MAXGO_PASSWORD=
MAXGO_VEHICLE_ID=
